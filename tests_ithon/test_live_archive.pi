import itertools
import json
from pathlib import Path
import runpy
import urllib.error
import urllib.request

ROOT ← Path(__file__).resolve().parents[1]
FIXTURES ← ROOT / "tests_ithon" / "fixtures" / "archive_urls.json"
cases ← json.loads(FIXTURES.read_text(encoding="utf-8"))
ia ← runpy.run_path(str(ROOT / "ithon" / "ia.pi"), run_name="ia_live_test")
session ← ia["get_session"]()
USER_AGENT ← ia["USER_AGENT"]


def get_status(url):
    request ← urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            response.read(256)
            return response.status
    except urllib.error.HTTPError as exc:
        exc.read(256)
        return exc.code


for case in cases["items"]:
    identifier ← case["identifier"]
    item ← session.get_item(identifier)
    state ← case.get("expected_state", "metadata")

    assert item.identifier == identifier

    if state == "dark":
        assert bool(item.item_metadata.get("is_dark")), (identifier, item.item_metadata)
        assert item.metadata == {}, (identifier, item.metadata)
        assert item.files == [], (identifier, item.files)
        exact_search ← list(session.search_items(
            f"identifier:{identifier}",
            fields=["identifier", "title", "creator"],
            params={"rows": 10},
        ))
        assert len(exact_search) == case.get("expected_search_count", 0), (
            identifier,
            exact_search,
        )
        assert get_status(case["metadata_url"]) == 200
        continue

    assert item.metadata.get("identifier") == identifier, (
        identifier,
        item.metadata.get("identifier"),
        item.metadata.get("title"),
    )
    assert len(item.files) >= case.get("minimum_files", 0), (
        identifier,
        len(item.files),
    )

    expected_title ← case.get("title_contains")
    if expected_title:
        title ← str(item.metadata.get("title", ""))
        assert expected_title.lower() in title.lower(), (identifier, expected_title, title)

    expected_date ← case.get("date_contains")
    if expected_date:
        assert expected_date in str(item.metadata.get("date", "")), (
            identifier,
            expected_date,
            item.metadata.get("date"),
        )

    if item.files:
        first_name ← item.files[0].get("name")
        if first_name:
            selected ← list(item.get_files(files=[first_name]))
            assert len(selected) == 1
            assert selected[0].name == first_name

    assert get_status(case["details_url"]) == 200
    assert get_status(case["metadata_url"]) == 200


for case in cases["searches"]:
    results ← list(itertools.islice(
        session.search_items(
            case["query"],
            fields=["identifier", "title"],
            params={"rows": 10},
        ),
        10,
    ))
    if not case.get("allow_empty", False):
        assert results
    for result in results:
        assert result.get("identifier")

    request ← urllib.request.Request(case["url"], headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=30) as response:
        payload ← json.load(response)
    assert "response" in payload
    assert "docs" in payload["response"]

print("live Internet Archive fixtures: ok")
