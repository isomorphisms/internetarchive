import json
import os
from pathlib import Path
import runpy
import urllib.request

ROOT ← Path(__file__).resolve().parents[1]
SNAPSHOT_DIR ← Path(os.environ.get("ARCHIVE_SNAPSHOT_DIR", "browser-responses"))
ia ← runpy.run_path(str(ROOT / "ithon" / "ia.pi"), run_name="ia_differential_test")
session ← ia["get_session"]()
USER_AGENT ← ia["USER_AGENT"]

ITEMS ← {
    "hegelmythslegend0000unse": {
        "title_contains": "Hegel",
        "year": "1996",
    },
    "tatalecturesonth00mumf_330": {
        "title_contains": "Tata",
        "year": "1983",
    },
    "nasa": {},
}

STABLE_METADATA_KEYS ← (
    "identifier",
    "title",
    "creator",
    "date",
    "description",
    "mediatype",
    "collection",
    "language",
    "publisher",
    "subject",
    "isbn",
)


def load_json(path):
    return json.loads(path.read_text(encoding="utf-8"))


def normalized_files(entries):
    result ← {}
    for entry in entries:
        name ← entry.get("name")
        if not name:
            continue
        result[name] ← (
            entry.get("size"),
            entry.get("md5"),
            entry.get("sha1"),
            entry.get("format"),
            entry.get("source"),
            entry.get("mtime"),
        )
    return result


def direct_range(url):
    request ← urllib.request.Request(
        url,
        headers={
            "User-Agent": USER_AGENT,
            "Range": "bytes=0-255",
        },
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        body ← response.read()
        assert response.status in (200, 206)
        assert body
        return body


for identifier, expected in ITEMS.items():
    curl_metadata ← load_json(SNAPSHOT_DIR / f"{identifier}.metadata.json")
    item ← session.get_item(identifier)

    # The Ithon client and curl must see the same stable metadata fields.
    curl_core ← curl_metadata.get("metadata", {})
    ithon_core ← item.metadata
    for key in STABLE_METADATA_KEYS:
        if key in curl_core or key in ithon_core:
            assert ithon_core.get(key) == curl_core.get(key), (
                identifier,
                key,
                ithon_core.get(key),
                curl_core.get(key),
            )

    # File inventory is a much stronger check than merely seeing HTTP 200.
    # Name, size, checksums, format, source and mtime must agree with curl JSON.
    assert normalized_files(item.files) == normalized_files(curl_metadata.get("files", []))

    # Independent facts established outside this client.
    if expected.get("title_contains"):
        assert expected["title_contains"].lower() in str(item.metadata.get("title", "")).lower()
    if expected.get("year"):
        metadata_text ← json.dumps(item.metadata, ensure_ascii=False)
        assert expected["year"] in metadata_text

    # Exact-identifier search must agree with curl's Advanced Search response.
    curl_search ← load_json(SNAPSHOT_DIR / f"{identifier}.search.json")
    curl_docs ← curl_search.get("response", {}).get("docs", [])
    ithon_docs ← list(session.search_items(
        f"identifier:{identifier}",
        fields=["identifier", "title", "creator"],
        params={"rows": 10},
    ))
    assert ithon_docs == curl_docs, (identifier, ithon_docs, curl_docs)
    assert any(document.get("identifier") == identifier for document in ithon_docs)

    # Probe only the first 256 bytes of the public _meta.xml. No full download.
    metadata_file ← item.get_file(f"{identifier}_meta.xml")
    expected_url ← f"https://archive.org/download/{identifier}/{identifier}_meta.xml"
    assert metadata_file.url == expected_url
    curl_range ← (SNAPSHOT_DIR / f"{identifier}.range.body").read_bytes()
    ithon_range ← direct_range(metadata_file.url)
    assert ithon_range == curl_range
    assert 1 <= len(ithon_range) <= 256


# The username probe is allowed to be empty, but two independent clients
# must still agree on the response structure and rows at the same moment.
curl_username ← load_json(SNAPSHOT_DIR / "isomorphisms.search.json")
curl_username_docs ← curl_username.get("response", {}).get("docs", [])
ithon_username_docs ← list(session.search_items(
    "uploader:isomorphisms",
    fields=["identifier", "title"],
    params={"rows": 10},
))
assert ithon_username_docs == curl_username_docs
for document in ithon_username_docs:
    assert document.get("identifier")

print("curl/Ithon differential Archive tests: ok")
